{
    "version": 2,
    "builds": [
     {
      "src": "*.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
     }
    ],
    "routes": [
      { "src": "/public/(.*)", "dest": "/public/$1" },
      { "src": "/menu",        "dest": "/index.js" },
      { "src": "/contact",     "dest": "/index.js" },
      { "src": "/about",       "dest": "/index.js" },
      { "src": "/login",       "dest": "/index.js" },
      { "src": "/register",    "dest": "/index.js" },
      { "src": "/(.*)",        "dest": "/index.js" }
    ]
   }
